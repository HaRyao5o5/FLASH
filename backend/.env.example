# このファイルをコピーして .env を作る（backend/.env）。.env は .gitignore 済み。

# development（手元）/ production（本番）
FLASH_ENV=development

# ---- DB（2本。理由は app/config.py の説明） ----
# docker compose up -d で立てた手元の PostgreSQL ならこのままで動く
FLASH_DATABASE_URL=postgresql+psycopg://flash_app:flash_app@localhost:5432/flash
FLASH_SYSTEM_DATABASE_URL=postgresql+psycopg://flash_owner:flash_owner@localhost:5432/flash

# ---- 鍵（python -m app.tools.make_key で2本まとめて作れる） ----
FLASH_SECRET_KEY=
# **一度決めたら変えない。** 変えると保存済みの接続が全部読めなくなる
FLASH_ENCRYPTION_KEY=

# ---- 誰を入れるか ----
# 大学の Google アカウントだけ通す
FLASH_ALLOWED_DOMAIN=g.nihon-u.ac.jp
# 招待する人（カンマ区切り）。空なら「ドメインが合えば誰でも」
FLASH_ALLOWED_EMAILS=
# サイトの管理者（あなた）
FLASH_ADMIN_EMAILS=

# ---- Google ログイン（手元では空でよい。開発用ログインで入れる） ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# リダイレクト先の土台。手元は http://localhost:8000、本番は https://<ドメイン>
FLASH_BASE_URL=http://localhost:8000

# 開発用ログイン（メールを打つだけで入れる）。production では何を書いても無効
FLASH_DEV_LOGIN=1

# ---- Canvas ----
FLASH_CANVAS_HOST=nu.instructure.com
# 何分おきに全員のフィードを読み直すか（0 でボタンだけ）
FLASH_SYNC_MINUTES=30
# 「今すぐ取り込む」の連打を止める間隔（秒）
FLASH_SYNC_COOLDOWN=60
